# Copy this file to .env and adjust as needed. docker compose loads .env
# automatically from the project root.

# Host ports each service is published on.
BACKEND_PORT=8000
OLLAMA_PORT=11434

# mcp-servers hosts multiple MCP servers in one container, each on its own
# port (see mcp-servers/servers.json). This is the host-side range mapped to
# that same range in the container — bump it if you add servers past 8010.
MCP_SERVERS_PORT_RANGE=8001-8010
